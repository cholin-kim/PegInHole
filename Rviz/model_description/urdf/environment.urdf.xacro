<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">
  <xacro:include filename="$(arg path)/model_description/urdf/xkcd_colors.urdf"/>  
  <xacro:arg name="path" default="/home/surglab/PegInHole/Rviz"/>
  <xacro:arg name="xyz" default="0 0 0" />
  <xacro:arg name="rpy" default="0 0 0" />
  
  <link name="base">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </link>

  <!-- <joint name="base_joint_worktable" type="fixed">
    <parent link="base"/>
    <child link="worktable"/>
  </joint>

  <link name="worktable">
    <visual>
      <origin xyz="$(arg xyz)" rpy="$(arg rpy)"/>
